{
  "$defs": {
    "Clue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "gm_notes": {
          "default": "",
          "maxLength": 1500,
          "title": "Gm Notes",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "text"
      ],
      "title": "Clue",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{2,47}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "authors": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Authors",
          "type": "array"
        },
        "license": {
          "default": "",
          "maxLength": 80,
          "title": "License",
          "type": "string"
        },
        "tags": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 24,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "gm_notes": {
          "default": "",
          "maxLength": 3000,
          "title": "Gm Notes",
          "type": "string"
        },
        "kind": {
          "default": "scene",
          "enum": [
            "scene",
            "ending"
          ],
          "title": "Kind",
          "type": "string"
        },
        "clues": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,47}$",
            "type": "string"
          },
          "maxItems": 24,
          "title": "Clues",
          "type": "array"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "maxItems": 12,
          "title": "Transitions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "text"
      ],
      "title": "Scene",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9-]{0,47}$",
          "title": "Target",
          "type": "string"
        },
        "requires_clues": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,47}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Requires Clues",
          "type": "array"
        },
        "requires_rule_status": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "expired",
                "victory",
                "defeat",
                "retreated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requires Rule Status"
        },
        "gm_guidance": {
          "default": "",
          "maxLength": 1500,
          "title": "Gm Guidance",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "target"
      ],
      "title": "Transition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ember.scenario/v1",
      "title": "Format",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "rule_system": {
      "default": "ember-light/v1",
      "enum": [
        "ember-light/v1",
        "dnd5e-srd-5.2.1/v1",
        "ember-coop-settlement/v1"
      ],
      "title": "Rule System",
      "type": "string"
    },
    "objective": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "start_scene": {
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "title": "Start Scene",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "maxItems": 32,
      "minItems": 2,
      "title": "Scenes",
      "type": "array"
    },
    "clues": {
      "items": {
        "$ref": "#/$defs/Clue"
      },
      "maxItems": 48,
      "title": "Clues",
      "type": "array"
    }
  },
  "required": [
    "format",
    "metadata",
    "objective",
    "start_scene",
    "scenes"
  ],
  "title": "Scenario",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ember-tavern:scenario:v1"
}
