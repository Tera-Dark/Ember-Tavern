{
  "$defs": {
    "LoreEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "content": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "tags": {
          "default": "",
          "maxLength": 120,
          "title": "Tags",
          "type": "string"
        },
        "keys": {
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 24,
          "title": "Keys",
          "type": "array"
        },
        "kind": {
          "default": "lore",
          "enum": [
            "lore",
            "rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "visibility": {
          "default": "public",
          "enum": [
            "public",
            "gm"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "activation": {
          "default": "keywords",
          "enum": [
            "keywords",
            "always"
          ],
          "title": "Activation",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "maximum": 100,
          "minimum": -100,
          "title": "Priority",
          "type": "integer"
        }
      },
      "required": [
        "title",
        "content"
      ],
      "title": "LoreEntry",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{2,47}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "authors": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Authors",
          "type": "array"
        },
        "license": {
          "default": "",
          "maxLength": 80,
          "title": "License",
          "type": "string"
        },
        "tags": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 24,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "WorldData": {
      "additionalProperties": false,
      "description": "World data is limited to 384 KiB encoded UTF-8, in addition to field limits.",
      "properties": {
        "extensions": {
          "maxProperties": 16,
          "patternProperties": {
            "^[a-z][a-z0-9.-]{1,70}/v[1-9][0-9]*$": {
              "additionalProperties": true,
              "type": "object"
            }
          },
          "title": "Extensions",
          "type": "object"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "premise": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Premise",
          "type": "string"
        },
        "tone": {
          "default": "克制、神秘、有选择的代价",
          "maxLength": 160,
          "title": "Tone",
          "type": "string"
        },
        "rule_system": {
          "default": "ember-light/v1",
          "enum": [
            "ember-light/v1",
            "dnd5e-srd-5.2.1/v1",
            "ember-coop-settlement/v1"
          ],
          "title": "Rule System",
          "type": "string"
        },
        "lore": {
          "items": {
            "$ref": "#/$defs/LoreEntry"
          },
          "maxItems": 160,
          "title": "Lore",
          "type": "array"
        }
      },
      "required": [
        "title",
        "premise"
      ],
      "title": "WorldData",
      "type": "object",
      "x-max-bytes": 393216
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ember.worldbook/v1",
      "title": "Format",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "world": {
      "$ref": "#/$defs/WorldData"
    }
  },
  "required": [
    "format",
    "metadata",
    "world"
  ],
  "title": "Worldbook",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ember-tavern:worldbook:v1"
}
