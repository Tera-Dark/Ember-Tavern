{
  "$defs": {
    "UI": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Group",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 80,
          "title": "Label",
          "type": "string"
        },
        "slot": {
          "enum": [
            "toolbar",
            "main"
          ],
          "title": "Slot",
          "type": "string"
        },
        "height": {
          "default": 500,
          "maximum": 1200,
          "minimum": 120,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "group",
        "slot"
      ],
      "title": "UI",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9-]{2,47}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    },
    "description": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "authors": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 12,
      "title": "Authors",
      "type": "array"
    },
    "license": {
      "default": "",
      "maxLength": 80,
      "title": "License",
      "type": "string"
    },
    "homepage": {
      "anyOf": [
        {
          "maxLength": 400,
          "pattern": "^https://[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Homepage"
    },
    "minimum_host": {
      "default": "2.1.0",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Minimum Host",
      "type": "string"
    },
    "api_version": {
      "minimum": 1,
      "title": "Api Version",
      "type": "integer"
    },
    "state_version": {
      "default": 1,
      "minimum": 1,
      "title": "State Version",
      "type": "integer"
    },
    "default_enabled": {
      "default": false,
      "title": "Default Enabled",
      "type": "boolean"
    },
    "backend": {
      "anyOf": [
        {
          "const": "backend.py",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend"
    },
    "frontend": {
      "anyOf": [
        {
          "const": "ui.js",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frontend"
    },
    "category": {
      "default": "扩展",
      "maxLength": 64,
      "title": "Category",
      "type": "string"
    },
    "icon": {
      "default": "puzzle",
      "maxLength": 64,
      "title": "Icon",
      "type": "string"
    },
    "requires": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]{2,47}$",
        "type": "string"
      },
      "maxItems": 40,
      "title": "Requires",
      "type": "array"
    },
    "uses": {
      "items": {
        "pattern": "^[a-z][a-z0-9.-]{1,70}/v[1-9][0-9]*$",
        "type": "string"
      },
      "maxItems": 40,
      "title": "Uses",
      "type": "array"
    },
    "provides": {
      "items": {
        "pattern": "^[a-z][a-z0-9.-]{1,70}/v[1-9][0-9]*$",
        "type": "string"
      },
      "maxItems": 40,
      "title": "Provides",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9:./_-]*$",
        "type": "string"
      },
      "maxItems": 40,
      "title": "Capabilities",
      "type": "array"
    },
    "actions": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{0,47}$",
        "type": "string"
      },
      "maxItems": 40,
      "title": "Actions",
      "type": "array"
    },
    "signals": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{0,47}$",
        "type": "string"
      },
      "maxItems": 40,
      "title": "Signals",
      "type": "array"
    },
    "hooks": {
      "items": {
        "const": "gm",
        "type": "string"
      },
      "maxItems": 1,
      "title": "Hooks",
      "type": "array"
    },
    "ui": {
      "anyOf": [
        {
          "$ref": "#/$defs/UI"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "description",
    "api_version"
  ],
  "title": "Manifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ember-tavern:plugin:v1"
}
