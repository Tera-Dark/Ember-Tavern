# Copy this file to .env. Do not commit a real .env or send API keys in chat.
# Without credentials the explicitly labelled demo rule script is available.
ENABLE_DEMO=true
SESSION_HOURS=168
AI_TIMEOUT_SECONDS=45
# Structured game context JSON characters, not model tokens or a billing cap.
# Total is clamped to 8000..96000; lore is bounded within the available total.
CONTEXT_MAX_CHARS=24000
LORE_CONTEXT_CHARS=6000
# Optional additional exact browser origins for WebSocket. No wildcard.
# A trusted proxy must replace X-Forwarded-Host; see docs/LAN_DEPLOYMENT.md.
ALLOWED_ORIGINS=
# DATA_DIR=/absolute/path/to/persistent-data

# Setting/knowledge advisor: Gemini native REST generateContent adapter.
# Select a model actually available to your API key; the ID is configurable.
GEMINI_API_KEY=
GEMINI_MODEL=

# Structured decision model. Base URL must include /v1 when your provider needs it.
# Supports compatible POST {base}/chat/completions, not an assumed "jev" provider.
DECISION_BASE_URL=https://api.openai.com/v1
DECISION_API_KEY=
DECISION_MODEL=
# Some compatible providers do not support response_format. Set false in that case.
DECISION_JSON_MODE=true

# Optional voice-tts plugin; OpenAI-compatible POST /audio/speech.
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy
# Actual project repository; not a claim of an established plugin marketplace.
PLUGIN_COMMUNITY_URL=https://github.com/Tera-Dark/Ember-Tavern
